    {"id": 10, "name": "Status JSON", "type": "json-query", "url": "https://example.com/status.json", "method": "GET",
     "jsonPath": "data.status", "expectedValue": "up", "interval": 60, "active": true},
    {"id": 11, "name": "Website", "type": "http", "url": "https://www.example.com", "method": "HEAD", "interval": 60, "active": true},
    {"id": 12, "name": "Postgres DB", "type": "postgres", "interval": 60, "active": true}
  ]
